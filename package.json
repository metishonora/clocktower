{
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "build:wasm": "wasm-pack build crates/wasm --target web --out-dir ../../web/src/generated/clocktower_wasm",
    "dev": "pnpm --dir web dev",
    "prototype:phase-control": "pnpm --dir web prototype:phase-control",
    "prototype:reveal-followup": "pnpm --dir web prototype:reveal-followup",
    "prototype:first-night-suggestion": "pnpm --dir web prototype:first-night-suggestion",
    "generate:acceptance:snv": "pnpm build:wasm && node scripts/generate-sects-and-violets-acceptance-fixtures.mjs",
    "build": "pnpm --dir web build",
    "test": "cargo test --workspace",
    "test:web": "pnpm --dir web test",
    "test:browser": "pnpm --dir web build && node scripts/run-production-browser-tests.mjs",
    "test-server": "node scripts/test-server-manager.mjs",
    "test:test-server": "node --test scripts/test-server-manager.test.mjs scripts/test-server-manager.integration.test.mjs .codex/hooks/test-server-lifecycle.test.mjs .codex/hooks/worktree-maintenance.test.mjs"
  }
}
