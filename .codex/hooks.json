{
  "description": "Clocktower test-server lifecycle guardrails and cleanup.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/test-server-lifecycle.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking Clocktower test-server command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/test-server-lifecycle.mjs\"",
            "timeout": 15,
            "statusMessage": "Reconciling the Clocktower test server"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/test-server-lifecycle.mjs\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
