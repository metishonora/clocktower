{
  "description": "Clocktower worktree lifecycle guardrails.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "git worktree prune --expire now",
            "timeout": 3,
            "statusMessage": "Pruning stale Clocktower worktree metadata"
          }
        ]
      }
    ]
  }
}
